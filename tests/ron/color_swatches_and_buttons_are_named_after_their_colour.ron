// A colour has no text, so a swatch's accessible name is the name of its
// colour, the Tailwind name (`blue-500`). A palette combo's button is a combo
// box, and the name of the colour it shows is its value, which follows a pick.
// Index 60 is red-500 and 5 is slate-500 of the Tailwind colours in `COLORS`.
(
    format_version: 3,
    name: "swatches are named after their colour and a palette combo's value is its colour",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        Check(App(Accessible(
            of: Nth(60, Within(Name("palette"), Component("ItemView"))),
            role: Some("ListItem"),
            label: Some("red-500"),
            value: None,
            states: [],
        ))),
        Check(App(Accessible(
            of: Nth(5, Within(Name("palette"), Component("ItemView"))),
            role: Some("ListItem"),
            label: Some("slate-500"),
            value: None,
            states: [],
        ))),
        // The button of a combo whose colour is slate-50 has it as its value.
        Check(App(Accessible(
            of: Within(Name("one palette combo"), Component("ColorPushButton")),
            role: Some("ComboBox"),
            label: None,
            value: Some("slate-50"),
            states: [Collapsed],
        ))),
        // A combo with nothing selected has an empty value.
        Check(App(Accessible(
            of: Within(Name("own palette combo"), Component("ColorPushButton")),
            role: Some("ComboBox"),
            label: None,
            value: Some(""),
            states: [Collapsed],
        ))),
        // It is expanded while its popup is open, and its value follows a pick.
        MoveTo(Within(Name("one palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Wait(2),
        Check(App(Accessible(
            of: Within(Name("one palette combo"), Component("ColorPushButton")),
            role: Some("ComboBox"),
            label: None,
            value: Some("slate-50"),
            states: [Expanded],
        ))),
        MoveTo(Nth(60, Within(Name("one palette combo popup"), Component("ItemView")))),
        Click(Left),
        Wait(2),
        Check(App(Accessible(
            of: Within(Name("one palette combo"), Component("ColorPushButton")),
            role: Some("ComboBox"),
            label: None,
            value: Some("red-500"),
            states: [Collapsed],
        ))),
    ],
    expect: [],
)
