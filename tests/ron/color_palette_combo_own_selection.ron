// A palette combo with a selection of its own picks a colour without moving
// the other combos or the palette: the combos choose from the same colours
// but select separately. The popups are the third "ColorPaletteComboFloat"
// for the own combo. Index 60 is red-500.
(
    format_version: 3,
    name: "a combo with its own selection leaves the others alone",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        MoveTo(Within(Name("own palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("own palette combo"), path: "State", is: Eq(Open))),
        Check(Visible(Nth(2, Name("ColorPaletteComboFloat")))),
        MoveTo(Nth(60, Within(Nth(2, Name("ColorPaletteComboFloat")), Component("ItemView")))),
        Click(Left),
        Check(App(Selected(of: Name("own palette combo"), items: ["red-500"]))),
        Check(Component(target: Name("own palette combo"), path: "State", is: Eq(Closed))),
        Check(Not(Visible(Nth(2, Name("ColorPaletteComboFloat"))))),
        Check(Component(
            target: Within(Name("own palette combo"), Component("ColorSquare")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9372549,green:0.26666668,blue:0.26666668,alpha:1.0))),
        )),
        Check(App(Selected(of: Name("first palette combo"), items: []))),
        Check(App(Selected(of: Name("second palette combo"), items: []))),
        Check(App(Selected(of: Name("palette"), items: []))),
        Check(Component(
            target: Within(Name("first palette combo"), Component("ColorSquare")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.0))),
        )),
    ],
    expect: [App(Selected(of: Name("own palette combo"), items: ["red-500"]))],
)
