// The wheel over a list scrolls what the pointer is over: list.rs reads the
// HoverMap and moves the ScrollPosition of every hovered node, so the
// "scrolling list", twelve rows in a "list scroll area" 100 pixels high,
// moves with the area around it. The list and its item views let the pointer
// through (Pickable should_block_lower is false), which is what lets the area
// below them be hovered. The scroll position that counts is the one the layout
// settles on (ComputedNode.scroll_position), clamped to what overflows; the
// ScrollPosition component itself takes whatever the wheel adds. A positive
// wheel y scrolls up.
(
    format_version: 3,
    name: "the wheel over a list scrolls it",
    setup: App(Lists),
    steps: [
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Eq(0.0),
        )),
        MoveTo(Within(Name("scrolling list"), Role(role: Button, label: "Row 1"))),
        // Down: negative y moves the contents up.
        Wheel(x: 0.0, y: -40.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Eq(40.0),
        )),
        // Further down, to the end of the rows, however far the wheel turns: the
        // ScrollPosition component goes to 2040, the layout stops at the overflow.
        Wheel(x: 0.0, y: -2000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Between(250.0, 350.0),
        )),
        // Back up, to the first row.
        Wheel(x: 0.0, y: 5000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Eq(0.0),
        )),
        // The wheel elsewhere leaves the list where it is.
        MoveTo(Role(role: Button, label: "Change theme")),
        Wheel(x: 0.0, y: -40.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
