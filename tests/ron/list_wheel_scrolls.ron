(
    format_version: 3,
    name: "the wheel over a list scrolls it",
    // Scroll positions assume default-size rows; larger text scrolls further.
    variants: ["default", "scale 2"],
    setup: App(Lists),
    steps: [
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
        MoveTo(Within(Name("scrolling list"), Role(role: ListItem, label: "Row 1"))),
        Wheel(x: 0.0, y: -40.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(40.0),
        )),
        Wheel(x: 0.0, y: -2000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(304.0),
        )),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(304.0),
        )),
        Wheel(x: 0.0, y: 5000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
        MoveTo(Role(role: Button, label: "Change theme")),
        Wheel(x: 0.0, y: -40.0),
        Wait(2),
        Check(Component(
            target: Within(Name("list scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
