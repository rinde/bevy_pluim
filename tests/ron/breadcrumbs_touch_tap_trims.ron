(
    format_version: 3,
    name: "a touch tap on a crumb trims the selection",
    setup: App(BreadCrumbs),
    steps: [
        Wait(2),
        TouchTap(Role(role: Button, label: "Go to Panel B")),
        TouchTap(Role(role: Button, label: "Go to panel B sub")),
        Wait(2),
        TouchTap(Within(Name("BreadCrumbs"), Role(role: Button, label: "Panel B"))),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home", "Panel B"]))),
    ],
    expect: [],
)
