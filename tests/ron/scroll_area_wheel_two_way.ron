(
    format_version: 3,
    name: "the wheel scrolls a two-way scroll area along both axes",
    setup: App(ScrollAreas),
    steps: [
        MoveTo(Name("two-way scroll area")),
        Wheel(x: -80.0, y: -150.0),
        Wait(2),
        Check(Component(
            target: Within(Name("two-way scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.x",
            is: Eq(80.0),
        )),
        Check(Component(
            target: Within(Name("two-way scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(150.0),
        )),
    ],
    expect: [],
)
