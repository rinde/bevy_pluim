// A button that would pass a bound is disabled and a press on it (forced, the
// tester refuses to click a disabled button) leaves the value alone, for each value type.
// The u8 stepper has a step of 2 over 0 to 8: from 7 another step would reach 9,
// from 1 one back would underflow, and both must stay put. After every
// refused press one press the other way proves the stepper still works.
(
    format_version: 3,
    name: "a numeric stepper stops at its minimum and maximum",
    setup: App(NumericStepper),
    steps: [
        MoveTo(Within(Name("default stepper"), Name("Decrease"))), Click(Left),
        Check(TextOf(Name("default stepper"), Exact("0"))),
        MoveTo(Within(Name("default stepper"), Name("Decrease"))), Check(Disabled(Within(Name("default stepper"), Name("Decrease")))), Force(Click(Left)),
        Check(TextOf(Name("default stepper"), Exact("0"))),
        MoveTo(Within(Name("default stepper"), Name("Increase"))), Click(Left),
        Check(TextOf(Name("default stepper"), Exact("1"))),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Click(Left),
        Check(TextOf(Name("u16 stepper"), Exact("15"))),
        MoveTo(Within(Name("u16 stepper"), Name("Increase"))), Check(Disabled(Within(Name("u16 stepper"), Name("Increase")))), Force(Click(Left)),
        Check(TextOf(Name("u16 stepper"), Exact("15"))),
        MoveTo(Within(Name("u16 stepper"), Name("Decrease"))), Click(Left),
        Check(TextOf(Name("u16 stepper"), Exact("14"))),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Click(Left),
        Check(TextOf(Name("u32 stepper"), Exact("5"))),
        MoveTo(Within(Name("u32 stepper"), Name("Decrease"))), Check(Disabled(Within(Name("u32 stepper"), Name("Decrease")))), Force(Click(Left)),
        Check(TextOf(Name("u32 stepper"), Exact("5"))),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Click(Left),
        Check(TextOf(Name("f32 stepper"), Exact("15.0"))),
        MoveTo(Within(Name("f32 stepper"), Name("Increase"))), Check(Disabled(Within(Name("f32 stepper"), Name("Increase")))), Force(Click(Left)),
        Check(TextOf(Name("f32 stepper"), Exact("15.0"))),
        MoveTo(Within(Name("f32 stepper"), Name("Decrease"))), Click(Left),
        Check(TextOf(Name("f32 stepper"), Exact("14.5"))),
        MoveTo(Within(Name("stepper by two"), Name("Increase"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Name("Increase"))), Check(Disabled(Within(Name("stepper by two"), Name("Increase")))), Force(Click(Left)),
        Check(TextOf(Name("stepper by two"), Exact("7"))),
        MoveTo(Within(Name("stepper by two"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Name("Decrease"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Name("Decrease"))), Click(Left),
        Check(TextOf(Name("stepper by two"), Exact("1"))),
        MoveTo(Within(Name("stepper by two"), Name("Decrease"))), Check(Disabled(Within(Name("stepper by two"), Name("Decrease")))), Force(Click(Left)),
        Check(TextOf(Name("stepper by two"), Exact("1"))),
    ],
    expect: [TextOf(Name("stepper by two"), Exact("1"))],
)
