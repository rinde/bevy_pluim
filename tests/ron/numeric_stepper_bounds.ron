// A press that would pass a bound leaves the value alone, for each value type.
// The u8 stepper has a step of 2 over 0 to 8: from 7 another step would reach 9,
// from 1 one back would underflow, and both must stay put. After every
// refused press one press the other way proves the stepper still works.
(
    format_version: 3,
    name: "a numeric stepper stops at its minimum and maximum",
    setup: App(NumericStepper),
    steps: [
        MoveTo(Within(Name("default stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("default stepper"), Exact("- 0 +"))),
        MoveTo(Within(Name("default stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("default stepper"), Exact("- 0 +"))),
        MoveTo(Within(Name("default stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("default stepper"), Exact("- 1 +"))),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("u16 stepper"), Exact("- 15 +"))),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("u16 stepper"), Exact("- 15 +"))),
        MoveTo(Within(Name("u16 stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("u16 stepper"), Exact("- 14 +"))),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("u32 stepper"), Exact("- 5 +"))),
        MoveTo(Within(Name("u32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("u32 stepper"), Exact("- 5 +"))),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("f32 stepper"), Exact("- 15.0 +"))),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("f32 stepper"), Exact("- 15.0 +"))),
        MoveTo(Within(Name("f32 stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("f32 stepper"), Exact("- 14.5 +"))),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("stepper by two"), Exact("- 7 +"))),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("stepper by two"), Exact("- 1 +"))),
        MoveTo(Within(Name("stepper by two"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("stepper by two"), Exact("- 1 +"))),
    ],
    expect: [TextOf(Name("stepper by two"), Exact("- 1 +"))],
)
