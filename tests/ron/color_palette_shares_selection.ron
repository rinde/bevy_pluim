// The palette and the palette in the scroll area share one selection
// (`Selection::reference`), so a swatch clicked in either selects the colour
// in both and marks it in both (a dark colour such as red-500 or slate-800 gets
// a border other than the theme's `background_primary`, gray-50). The combos
// choose from the same colours but keep selections of their own, so they do
// not change. Index 60 is red-500 and 8 is slate-800 of `COLORS`; the scroll
// area is 300 wide, which shows the first seven columns of swatches. `Selected`
// follows the shared selection in both.
(
    format_version: 3,
    name: "palettes that share a selection show the same colour",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        MoveTo(Nth(60, Within(Name("palette scroll area"), Component("ItemView")))),
        Click(Left),
        MoveTo(Screen((1100.0, 600.0))),
        Check(App(Selected(of: Within(Name("palette scroll area"), Component("ColorPalette")), items: ["red-500"]))),
        Check(App(Selected(of: Name("palette"), items: ["red-500"]))),
        Check(Selected(Nth(60, Within(Name("palette"), Component("ItemView"))))),
        Check(Selected(Nth(60, Within(Name("palette scroll area"), Component("ItemView"))))),
        Check(Not(Selected(Nth(8, Within(Name("palette"), Component("ItemView")))))),
        Check(Not(Selected(Nth(8, Within(Name("palette scroll area"), Component("ItemView")))))),
        Check(Component(
            target: Nth(60, Within(Name("palette"), Component("ItemView"))),
            path: "BorderColor.top",
            is: Ne(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(Component(
            target: Nth(60, Within(Name("palette scroll area"), Component("ItemView"))),
            path: "BorderColor.top",
            is: Ne(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(App(Selected(of: Name("first palette combo"), items: []))),
        Check(App(Selected(of: Name("own palette combo"), items: []))),
        // And the other way round: a swatch of the big palette replaces it.
        MoveTo(Nth(8, Within(Name("palette"), Component("ItemView")))),
        Click(Left),
        MoveTo(Screen((1100.0, 600.0))),
        Check(App(Selected(of: Name("palette"), items: ["slate-800"]))),
        Check(Selected(Nth(8, Within(Name("palette"), Component("ItemView"))))),
        Check(Selected(Nth(8, Within(Name("palette scroll area"), Component("ItemView"))))),
        Check(Not(Selected(Nth(60, Within(Name("palette"), Component("ItemView")))))),
        Check(Not(Selected(Nth(60, Within(Name("palette scroll area"), Component("ItemView")))))),
        Check(App(Selected(of: Within(Name("palette scroll area"), Component("ColorPalette")), items: ["slate-800"]))),
        Check(Component(
            target: Nth(60, Within(Name("palette scroll area"), Component("ItemView"))),
            path: "BorderColor.top",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(Component(
            target: Nth(8, Within(Name("palette scroll area"), Component("ItemView"))),
            path: "BorderColor.top",
            is: Ne(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(App(Selected(of: Name("first palette combo"), items: []))),
    ],
    expect: [App(Selected(of: Name("palette"), items: ["slate-800"]))],
)
