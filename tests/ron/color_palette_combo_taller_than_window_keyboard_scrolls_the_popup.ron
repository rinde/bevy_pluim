// The popup of the palette combo is capped to the 260 pixel window (see
// `color_palette_combo_taller_than_window_stays_inside_window`) and scrolls itself. Arrowing
// down moves the active swatch past the bottom of the view, so the popup scrolls to keep it in
// view (`scroll_into_view` scrolls a scrolling `FixedNode` popup); Home returns to the top.
(
    format_version: 3,
    name: "arrow keys scroll a palette combo popup taller than the window to the active swatch",
    window_size: Some((1280, 260)),
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Wait(1),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Wait(3),
        Check(Component(target: Within(Name("first palette combo popup"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(0.0))),
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown),         Tap(key: ArrowDown), 
        Wait(2),
        Check(Component(target: Within(Name("first palette combo popup"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Gt(50.0))),
        Tap(key: Home),
        Wait(2),
        Check(Component(target: Within(Name("first palette combo popup"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Le(3.0))),
    ],
    expect: [],
)
