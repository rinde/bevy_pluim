// Clicking a crumb trims the `OneOrMore` selection back to it, and the trail
// shows the crumbs that are left. The `BreadCrumbs` screen starts on "Home";
// the buttons in the panels of the stack add "Panel B" and "Panel B sub" to the
// trail. The last crumb is the current panel and a disabled button (`[disabled]`
// in a `Tree(..)` snapshot: `InteractionDisabled`); the ones before it are
// buttons. `breadcrumbs.rs` observes `Activate` for the crumbs, which a `Click`
// on the crumb triggers.
(
    format_version: 3,
    name: "clicking a crumb trims the selection back to it",
    setup: App(BreadCrumbs),
    steps: [
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home"]))),
        Check(Tree(of: Name("BreadCrumbs"), matches: r#"
            - panel "BreadCrumbs":
              - button "Home" [disabled]
        "#)),

        // Home > Panel B > Panel B sub.
        MoveTo(Role(role: Button, label: "Go to Panel B")), Click(Left),
        MoveTo(Role(role: Button, label: "Go to panel B sub")), Click(Left),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home", "Panel B", "Panel B sub"]))),
        Check(Tree(of: Name("BreadCrumbs"), matches: r#"
            - panel "BreadCrumbs":
              - button "Home"
              - panel:
                - text " > "
                - button "Panel B"
              - panel:
                - text " > "
                - button "Panel B sub" [disabled]
        "#)),

        // Back to "Panel B": the last crumb goes, the one clicked becomes the disabled one.
        MoveTo(Within(Name("BreadCrumbs"), Role(role: Button, label: "Panel B"))), Click(Left),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home", "Panel B"]))),
        Check(Tree(of: Name("BreadCrumbs"), matches: r#"
            - panel "BreadCrumbs":
              - button "Home"
              - panel:
                - text " > "
                - button "Panel B" [disabled]
        "#)),
        Check(Not(Exists(Within(Name("BreadCrumbs"), Text("Panel B sub"))))),
        // The stack follows the trail.
        Check(Tree(of: Name("Stack"), matches: r#"
            - panel "Stack":
              - panel "StackItem":
                - text "Panel B"
        "#)),

        // Forward to "Panel B sub" again, then all the way back to "Home".
        MoveTo(Role(role: Button, label: "Go to panel B sub")), Click(Left),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home", "Panel B", "Panel B sub"]))),
        MoveTo(Within(Name("BreadCrumbs"), Role(role: Button, label: "Home"))), Click(Left),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home"]))),
        Check(Tree(of: Name("BreadCrumbs"), matches: r#"
            - panel "BreadCrumbs":
              - button "Home" [disabled]
        "#)),
        Check(Not(Exists(Within(Name("BreadCrumbs"), Text("Panel B"))))),
        Check(Tree(of: Name("Stack"), matches: r#"
            - panel "Stack":
              - panel "StackItem":
                - text "Home"
        "#)),
    ],
    expect: [
        App(Selected(of: Name("BreadCrumbs"), items: ["Home"])),
        Not(Exists(Within(Name("BreadCrumbs"), Text("Panel B")))),
    ],
)
