// What the accessibility tree says about push buttons today, read with the
// test app's own `App(Accessible(..))` check (tests/widgets_check/mod.rs): a
// `PushButton` is a `Button`, and one with `InteractionDisabled` is `Disabled`.
//
// Its label is its text (see button_names_are_their_text.ron).
(
    format_version: 3,
    name: "push buttons are buttons, disabled when disabled",
    setup: App(Buttons),
    steps: [
        Wait(2),
        Check(App(Accessible(
            of: Role(role: Button, label: "Add"),
            role: Some("Button"),
            label: Some("Add"),
            value: None,
            states: [Enabled, Shown],
        ))),
        Check(App(Accessible(
            of: Role(role: Button, label: "Disabled"),
            role: Some("Button"),
            label: Some("Disabled"),
            value: None,
            states: [Disabled],
        ))),
    ],
    expect: [],
)
