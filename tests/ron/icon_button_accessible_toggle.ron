(
    format_version: 3,
    name: "a toggle icon button is toggled with its state and a plain one is not a toggle",
    setup: App(IconButtons),
    steps: [
        Wait(2),
        Check(App(Accessible(
            of: Name("toggle button"),
            role: Some("Button"),
            label: None,
            value: None,
            states: [NotToggled],
        ))),
        Check(Not(App(Accessible(
            of: Name("regular button"),
            role: Some("Button"),
            label: None,
            value: None,
            states: [NotToggled],
        )))),
        Check(Not(App(Accessible(
            of: Name("regular button"),
            role: Some("Button"),
            label: None,
            value: None,
            states: [Toggled],
        )))),
        MoveTo(Name("toggle button")),
        Click(Left),
        Wait(1),
        Check(App(Accessible(
            of: Name("toggle button"),
            role: Some("Button"),
            label: None,
            value: None,
            states: [Toggled],
        ))),
        Click(Left),
        Wait(1),
        Check(App(Accessible(
            of: Name("toggle button"),
            role: Some("Button"),
            label: None,
            value: None,
            states: [NotToggled],
        ))),
    ],
    expect: [],
)
