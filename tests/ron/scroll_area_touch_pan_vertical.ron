(
    format_version: 3,
    name: "a finger pan scrolls the vertical scroll area by the finger's movement",
    setup: App(ScrollAreas),
    steps: [
        Wait(2),
        TouchDown(at: Screen((340.0, 150.0)), finger: 0),
        TouchMove(to: Screen((340.0, 90.0)), finger: 0),
        Wait(1),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0", is: Eq((0.0, 60.0)))),
        TouchMove(to: Screen((340.0, 70.0)), finger: 0),
        Wait(1),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0", is: Eq((0.0, 80.0)))),
        TouchMove(to: Screen((340.0, 200.0)), finger: 0),
        Wait(1),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0", is: Eq((0.0, 0.0)))),
        TouchUp(finger: 0),
        TouchDown(at: Screen((340.0, 150.0)), finger: 0),
        TouchMove(to: Screen((290.0, 150.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(1),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0", is: Eq((0.0, 0.0)))),
    ],
    expect: [],
)
