(
    format_version: 3,
    name: "a new touch or a wheel turn stops a fling",
    setup: App(ScrollAreas),
    steps: [
        Wait(2),
        TouchDown(at: Screen((340.0, 200.0)), finger: 0),
        TouchMove(to: Screen((340.0, 185.0)), finger: 0),
        TouchMove(to: Screen((340.0, 170.0)), finger: 0),
        TouchMove(to: Screen((340.0, 155.0)), finger: 0),
        TouchMove(to: Screen((340.0, 140.0)), finger: 0),
        TouchMove(to: Screen((340.0, 125.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(20),
        TouchDown(at: Screen((340.0, 100.0)), finger: 0),
        Capture(name: "caught", value: Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y")),
        Wait(120),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(Captured("caught")))),
        TouchUp(finger: 0),
        Wait(60),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(Captured("caught")))),
        TouchDown(at: Screen((340.0, 200.0)), finger: 0),
        TouchMove(to: Screen((340.0, 185.0)), finger: 0),
        TouchMove(to: Screen((340.0, 170.0)), finger: 0),
        TouchMove(to: Screen((340.0, 155.0)), finger: 0),
        TouchMove(to: Screen((340.0, 140.0)), finger: 0),
        TouchMove(to: Screen((340.0, 125.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(20),
        MoveTo(Name("vertical scroll area")),
        Wheel(x: 0.0, y: -1.0),
        Wait(1),
        Capture(name: "wheeled", value: Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y")),
        Wait(120),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(Captured("wheeled")))),
    ],
    expect: [],
)
