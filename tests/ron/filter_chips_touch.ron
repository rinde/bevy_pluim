(
    format_version: 3,
    name: "a touch tap on a chip selects it and leaves no hover look",
    setup: App(FilterChips),
    steps: [
        Wait(2),
        Capture(name: "resting ink", value: Component(target: Within(Name("status chips"), Text("Running")), path: "TextColor.0")),
        TouchDown(at: Within(Name("status chips"), Role(role: Button, label: "Running 2")), finger: 0),
        TouchMove(to: Screen((900.0, 500.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(App(Selected(of: Name("status chips"), items: ["All"]))),
        Check(Component(target: Within(Name("status chips"), Text("Running")), path: "TextColor.0", is: Eq(Captured("resting ink")))),
        TouchTap(Within(Name("status chips"), Role(role: Button, label: "Running 2"))),
        Wait(2),
        Check(App(Selected(of: Name("status chips"), items: ["Running"]))),
        Check(App(Selected(of: Name("mirror chips"), items: ["Running"]))),
        Check(App(Selected(of: Name("narrow chips"), items: ["Alpha"]))),
        Check(Component(target: Within(Name("status chips"), Text("All")), path: "TextColor.0", is: Eq(Captured("resting ink")))),
        TouchTap(Within(Name("narrow chips"), Role(role: Button, label: "Gamma "))),
        Wait(2),
        Check(App(Selected(of: Name("narrow chips"), items: ["Gamma"]))),
        Check(App(Selected(of: Name("status chips"), items: ["Running"]))),
        Check(App(Focused(of: Within(Name("narrow chips"), Role(role: Button, label: "Gamma "))))),
        Tap(key: ArrowRight),
        Check(App(Focused(of: Within(Name("narrow chips"), Role(role: Button, label: "Delta "))))),
    ],
    expect: [],
)
