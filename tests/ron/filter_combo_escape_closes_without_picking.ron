// Escape closes the popup without applying the active option, the focus goes back to the button
// and reopening starts with an empty query and every option.
(
    format_version: 3,
    name: "Escape closes a filter combo without picking and it reopens unfiltered",
    setup: App(FilterCombos),
    steps: [
        MoveTo(Within(Name("filter combo"), Component("ComboButton"))),
        Click(Left),
        Wait(3),
        Type(text: "den"),
        Wait(2),
        Check(Component(target: Nth(0, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(1, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(2, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(3, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(4, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(App(Active(of: Within(Name("filter combo"), Component("TextInput")), is: Nth(2, Within(Name("filter combo"), Component("ItemView")))))),
        Tap(key: Escape),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Closed))),
        Check(App(Selected(of: Name("filter combo"), items: []))),
        Check(App(Focused(of: Within(Name("filter combo"), Component("ComboButton"))))),
        Check(Not(Visible(Within(Name("filter combo"), Component("ComboList"))))),
        MoveTo(Screen((900.0, 500.0))),
        MoveTo(Within(Name("filter combo"), Component("ComboButton"))),
        Click(Left),
        Wait(3),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Open))),
        Check(TextOf(Within(Name("filter combo"), Component("TextInput")), Exact(""))),
        Check(Component(target: Nth(0, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(1, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(2, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(3, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(4, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(Flex))),
    ],
    expect: [],
)
