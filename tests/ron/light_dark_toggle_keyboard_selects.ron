// The options are one tab stop that enters at the current preference (System): the arrows move
// the focus and pick, Enter on the focused option keeps it.
(
    format_version: 3,
    name: "a light dark toggle is driven from the keyboard",
    setup: App(LightDarkToggle),
    steps: [
        Wait(2),
        Tap(key: Tab),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "System"))))),
        Tap(key: ArrowRight),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Tap(key: Enter),
        Wait(2),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
    ],
)
