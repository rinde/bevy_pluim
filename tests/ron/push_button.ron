// The first scenario of tests/scenarios.rs as data: a push button follows the
// light theme under the pointer, and the click is counted. The colours are the
// slots of DEFAULT_LIGHT_THEME_COLORS: background_primary, hovered_item,
// selected_hovered_item and hovered_item again (the pointer is still on the
// button after the release), in the order the steps reach them.
(
    format_version: 3,
    name: "a push button follows the theme under the pointer",
    setup: App(Buttons),
    steps: [
        Check(Component(
            target: Role(role: Button, label: "Add"),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        MoveTo(Role(role: Button, label: "Add")),
        Check(Component(
            target: Role(role: Button, label: "Add"),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0))),
        )),
        Press(Left),
        Check(Component(
            target: Role(role: Button, label: "Add"),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.3764706,green:0.64705884,blue:0.98039216,alpha:1.0))),
        )),
        Check(Resource(path: "Clicks.0", is: Eq(0))),
        Release(Left),
        Check(Component(
            target: Role(role: Button, label: "Add"),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0))),
        )),
        Check(Resource(path: "Clicks.0", is: Eq(1))),
        MoveTo(Role(role: Button, label: "Other")),
        Check(Component(
            target: Role(role: Button, label: "Add"),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
    ],
    expect: [Resource(path: "Clicks.0", is: Eq(1))],
)
