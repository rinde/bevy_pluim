// The list of the 80 option `long combo` is capped to the window and scrolls itself. Arrowing
// down moves the active row past the bottom of the view, so the list scrolls to keep it in view
// (`scroll_into_view` scrolls a scrolling `FixedNode` popup); Home returns to the top.
(
    format_version: 3,
    name: "arrow keys scroll a combo list taller than the window to the active row",
    setup: App(Combos),
    steps: [
        Wait(2),
        MoveTo(Within(Name("long combo"), Component("ComboButton"))),
        Click(Left),
        Check(Component(target: Name("long combo"), path: "ComboState", is: Eq(Open))),
        Wait(3),
        Check(Component(target: Within(Name("long combo"), Component("ComboList")), path: "ScrollPosition.0.y", is: Eq(0.0))),
        Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), 
        Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), 
        Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), Tap(key: ArrowDown), 
        Wait(2),
        Check(Component(target: Within(Name("long combo"), Component("ComboList")), path: "ScrollPosition.0.y", is: Gt(0.0))),
        Tap(key: Home),
        Wait(2),
        Check(Component(target: Within(Name("long combo"), Component("ComboList")), path: "ScrollPosition.0.y", is: Eq(0.0))),
    ],
    expect: [],
)
