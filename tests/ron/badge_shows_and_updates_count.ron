// A badge is a pill with a count on the corner of its button. The counted
// button starts at 3, the warning button says 12, and the button with no badge
// has none. "Add badge" inserts a new count and the pill follows.
(
    format_version: 3,
    name: "a badge shows its count on the button and follows a new count",
    setup: App(Badge),
    steps: [
        Wait(2),
        Check(Visible(Within(Name("counted button"), Text("3")))),
        Check(Visible(Within(Name("warning button"), Text("12")))),
        Check(Not(Exists(Within(Name("plain button"), Name("Badge"))))),
        MoveTo(Role(role: Button, label: "Add badge")),
        Click(Left),
        Wait(2),
        Check(Visible(Within(Name("counted button"), Text("4")))),
        Check(Not(Exists(Within(Name("counted button"), Text("3"))))),
        Click(Left),
        Wait(2),
        Check(Visible(Within(Name("counted button"), Text("5")))),
        Check(Visible(Within(Name("warning button"), Text("12")))),
    ],
    expect: [],
)
