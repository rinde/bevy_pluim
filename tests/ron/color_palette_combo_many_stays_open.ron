// A palette combo over a selection of many keeps its popup open when swatches are picked
// (clicks and Enter), shows the first selected colour in its square and names all the
// selected colours, in selection order, as the value of its combo box. "zero or more
// palette combo" starts empty, "one or more palette combo" with slate-50. Index 60 is
// red-500, 5 is slate-500 and 0 slate-50 of `COLORS`.
(
    format_version: 3,
    name: "picking colours in a palette combo over many keeps the popup open",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        Check(App(Selected(of: Name("zero or more palette combo"), items: []))),
        Check(App(Accessible(of: Within(Name("zero or more palette combo"), Component("ColorPushButton")), role: Some("ComboBox"), label: None, value: Some(""), states: []))),
        Check(App(Selected(of: Name("one or more palette combo"), items: ["slate-50"]))),
        Check(App(Accessible(of: Within(Name("one or more palette combo"), Component("ColorPushButton")), role: Some("ComboBox"), label: None, value: Some("slate-50"), states: []))),
        MoveTo(Within(Name("zero or more palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        MoveTo(Nth(60, Within(Name("zero or more palette combo popup"), Component("ItemView")))),
        Click(Left),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        MoveTo(Nth(5, Within(Name("zero or more palette combo popup"), Component("ItemView")))),
        Click(Left),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(App(Selected(of: Name("zero or more palette combo"), items: ["red-500", "slate-500"]))),
        Wait(2),
        Check(App(Accessible(of: Within(Name("zero or more palette combo"), Component("ColorPushButton")), role: Some("ComboBox"), label: None, value: Some("red-500, slate-500"), states: [Expanded]))),
        // Deselecting the first one leaves the second as the preview.
        MoveTo(Nth(60, Within(Name("zero or more palette combo popup"), Component("ItemView")))),
        Click(Left),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(App(Selected(of: Name("zero or more palette combo"), items: ["slate-500"]))),
        // Keyboard: the focus is on the palette, Enter picks the active row and stays open.
        Tap(key: ArrowDown),
        Tap(key: Enter),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        // Escape still closes.
        Tap(key: Escape),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
    ],
    expect: [Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))],
)
