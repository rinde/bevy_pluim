// A finger down on a row shows the pressed (selected) look; after the finger lifts, slides
// off or is cancelled no hover look stays: the row is selected or at rest, never hovered.
(
    format_version: 3,
    name: "a finger leaves no hover look on a list row",
    setup: App(Lists),
    steps: [
        Wait(2),
        TouchDown(at: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")), finger: 0),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0))),
        )),
        // Slide off: nothing is picked and the row is at rest, not hovered.
        TouchMove(to: Screen((1100.0, 700.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(App(Selected(of: Name("one-or-more list"), items: ["Netherlands"]))),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        // A tap that picks: selected, with no hover colour after the lift.
        TouchTap(Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada"))),
        Wait(2),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0))),
        )),
        // A tap that deselects: back to rest, not hovered.
        TouchTap(Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada"))),
        Wait(2),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        // A cancelled touch picks nothing and leaves the row at rest.
        TouchDown(at: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")), finger: 0),
        TouchCancel(finger: 0),
        Wait(2),
        Check(App(Selected(of: Name("one-or-more list"), items: ["Netherlands"]))),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        // The separated list: a tap picks and leaves the selected look, the others stay clear.
        TouchTap(Within(Name("separated list"), Role(role: ListItem, label: "CA"))),
        Wait(2),
        Check(Component(
            target: Within(Name("separated list"), Role(role: ListItem, label: "NL")),
            path: "BackgroundColor.0",
            is: Eq(LinearRgba((red:0.0,green:0.0,blue:0.0,alpha:0.0))),
        )),
        Check(Selected(Within(Name("separated list"), Role(role: ListItem, label: "CA")))),
    ],
    expect: [App(Selected(of: Name("one-or-more list"), items: ["Netherlands"]))],
)
