// A palette combo's popup is a `Float` that is a child of the root, not of the
// combo, so a file reaches it by the name of its combo and "popup" ("first
// palette combo popup", "second ..", "own .."). It is hidden until the
// button is pressed and then placed under the button. Positions are
// `UiGlobalTransform` translations (the centre of the node, in window pixels),
// and every check is against the button's own position, captured before the
// popup opens, so none of it depends on where the screen puts the row: the
// popup's top edge is the button's bottom edge plus 3 pixels, so its centre y
// is the button's centre y plus half the button, 3 and half the popup. The
// combos sit in the middle of the window, where nothing pushes the popup back
// in, so the popup is centred on its button: its centre x is the button's
// centre x, the first time it opens as well as later. The button's centre can
// be on a half pixel and the layout rounds the popup's left edge to a whole
// one, so the x check allows that half pixel and nothing more.
(
    format_version: 3,
    name: "a palette combo opens its popup under its button",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(Not(Visible(Name("second palette combo popup")))),
        Check(Not(Visible(Name("own palette combo popup")))),
        // The first combo.
        Capture(name: "first button x", value: Component(target: Within(Name("first palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.x", unit: Logical)),
        Capture(name: "first button y", value: Component(target: Within(Name("first palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.y", unit: Logical)),
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(Visible(Name("first palette combo popup"))),
        Check(Component(target: Name("first palette combo popup"), path: "UiGlobalTransform.0.translation.y", unit: Logical, is: Eq(Captured(name: "first button y", plus: 145.5)))),
        Check(Component(target: Name("first palette combo popup"), path: "UiGlobalTransform.0.translation.x", unit: Logical, is: Between(Captured(name: "first button x", plus: -0.5), Captured(name: "first button x", plus: 0.5)))),
        // The popup floats over the palette below it: a swatch of the popup is
        // what receives the pointer, so it can be reached.
        MoveTo(Nth(0, Within(Name("first palette combo popup"), Component("ItemView")))),
        Check(Hovered(Nth(0, Within(Name("first palette combo popup"), Component("ItemView"))))),
        // Pressing the button of the second combo closes the first popup (the
        // click is outside the first combo) and opens its own, one button
        // further to the right.
        Capture(name: "second button x", value: Component(target: Within(Name("second palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.x", unit: Logical)),
        Capture(name: "second button y", value: Component(target: Within(Name("second palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.y", unit: Logical)),
        MoveTo(Within(Name("second palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(Component(target: Name("second palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(Visible(Name("second palette combo popup"))),
        Check(Component(target: Name("second palette combo popup"), path: "UiGlobalTransform.0.translation.y", unit: Logical, is: Eq(Captured(name: "second button y", plus: 145.5)))),
        Check(Component(target: Name("second palette combo popup"), path: "UiGlobalTransform.0.translation.x", unit: Logical, is: Between(Captured(name: "second button x", plus: -0.5), Captured(name: "second button x", plus: 0.5)))),
        // Nothing was selected by opening.
        Check(App(Selected(of: Name("second palette combo"), items: []))),
        // The button toggles: a second press closes it.
        Click(Left),
        Check(Component(target: Name("second palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("second palette combo popup")))),
    ],
    expect: [],
)
