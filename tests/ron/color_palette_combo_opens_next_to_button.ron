// A palette combo's popup is a `Float` that is a child of the root, not of the
// combo, so a file reaches it by the name of its combo and "popup" ("first
// palette combo popup", "second ..", "own .."). It is hidden until the
// button is pressed and then placed under the button, using the button's
// `UiGlobalTransform` (the centre of the node, in window pixels): its top edge
// is the button's bottom edge (55 = 37.5 + 35 / 2 on this screen) plus 3 pixels,
// and the popup is 430 by 250, so its centre is 58 + 125 = 183 down. The
// combos sit in the middle of the window, where nothing pushes the popup back
// in, so the popup is centred on its button: its centre x is the button's
// centre x (507.5 and 566.5), the first time it opens as well as later. The
// button is 39 pixels wide, so its centre is on a half pixel and the layout
// rounds the popup's left edge to a whole one: the check allows that half pixel
// (507.5 +- 0.5) and nothing more.
(
    format_version: 3,
    name: "a palette combo opens its popup under its button",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        Check(Component(target: Name("first palette combo"), path: "State", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(Not(Visible(Name("second palette combo popup")))),
        Check(Not(Visible(Name("own palette combo popup")))),
        // The first combo.
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "State", is: Eq(Open))),
        Check(Visible(Name("first palette combo popup"))),
        Check(Component(target: Name("first palette combo popup"), path: "UiGlobalTransform.0.translation.y", is: Eq(183.0))),
        Check(Component(target: Name("first palette combo popup"), path: "ComputedNode.size.x", is: Eq(430.0))),
        Check(Component(target: Name("first palette combo popup"), path: "UiGlobalTransform.0.translation.x", is: Between(507.0, 508.0))),
        Check(Component(target: Within(Name("first palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.x", is: Eq(507.5))),
        // The popup floats over the palette below it: a swatch of the popup is
        // what receives the pointer, so it can be reached.
        MoveTo(Nth(0, Within(Name("first palette combo popup"), Component("ItemView")))),
        Check(Hovered(Nth(0, Within(Name("first palette combo popup"), Component("ItemView"))))),
        // Pressing the button of the second combo closes the first popup (the
        // click is outside the first combo) and opens its own, one button
        // further to the right.
        MoveTo(Within(Name("second palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "State", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(Component(target: Name("second palette combo"), path: "State", is: Eq(Open))),
        Check(Visible(Name("second palette combo popup"))),
        Check(Component(target: Name("second palette combo popup"), path: "UiGlobalTransform.0.translation.y", is: Eq(183.0))),
        Check(Component(target: Name("second palette combo popup"), path: "UiGlobalTransform.0.translation.x", is: Between(566.0, 567.0))),
        Check(Component(target: Within(Name("second palette combo"), Component("ColorPushButton")), path: "UiGlobalTransform.0.translation.x", is: Eq(566.5))),
        // Nothing was selected by opening.
        Check(App(Selected(of: Name("second palette combo"), items: []))),
        // The button toggles: a second press closes it.
        Click(Left),
        Check(Component(target: Name("second palette combo"), path: "State", is: Eq(Closed))),
        Check(Not(Visible(Name("second palette combo popup")))),
    ],
    expect: [],
)
