(
    format_version: 3,
    name: "a tap outside an open combo closes it without changing the selection",
    setup: App(Combos),
    steps: [
        Wait(2),
        TouchTap(Within(Name("first combo"), Component("ComboButton"))),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        TouchTap(Screen((900.0, 500.0))),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
        Check(App(Selected(of: Name("first combo"), items: []))),
        Check(Not(Hovered(Within(Name("first combo"), Component("ComboButton"))))),
        TouchTap(Within(Name("first combo"), Component("ComboButton"))),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        TouchTap(Within(Name("own combo"), Component("ComboButton"))),
        Check(Component(target: Name("own combo"), path: "ComboState", is: Eq(Open))),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
    ],
    expect: [App(Selected(of: Name("first combo"), items: []))],
)
