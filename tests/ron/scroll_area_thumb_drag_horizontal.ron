// Dragging the thumb of the horizontal scroll area to the right scrolls its
// contents sideways by the share of what overflows that the thumb travelled of
// its track: partway, to the end, which stops at the last of the contents
// however far the pointer goes, and back to the start. The scroll position that
// counts is the value that was set (ScrollPosition.0, logical pixels).
(
    format_version: 3,
    name: "dragging the thumb of a horizontal scroll area scrolls the contents",
    setup: App(ScrollAreas),
    steps: [
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.x",
            is: Eq(0.0),
        )),
        Drag(
            from: Within(Name("horizontal scroll area"), Name("ScrollThumb")),
            to: Screen((560.0, 216.0)),
            frames: 5,
        ),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.x",
            is: Between(100.0, 1300.0),
        )),
        Drag(
            from: Within(Name("horizontal scroll area"), Name("ScrollThumb")),
            to: Screen((1270.0, 216.0)),
            frames: 5,
        ),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.x",
            is: Eq(1306.0),
        )),
        Drag(
            from: Within(Name("horizontal scroll area"), Name("ScrollThumb")),
            to: Screen((0.0, 216.0)),
            frames: 5,
        ),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.x",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
