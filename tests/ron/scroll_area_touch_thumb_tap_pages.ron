// A tap on the vertical scroll area's bar, beside the thumb, pages the contents
// by one visible length towards the tap, kept inside what overflows (see
// scroll_area_track_click_pages.ron for the geometry).
(
    format_version: 3,
    name: "a tap on the scroll bar beside the thumb pages the contents",
    setup: App(ScrollAreas),
    steps: [
        Wait(2),
        TouchTap(Screen((436.0, 200.0))),
        Wait(2),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(200.0))),
        TouchTap(Screen((436.0, 215.0))),
        Wait(2),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(220.0))),
        TouchTap(Screen((436.0, 30.0))),
        Wait(2),
        Check(Component(target: Within(Name("vertical scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Eq(20.0))),
    ],
    expect: [],
)
