(
    format_version: 3,
    name: "a finger shows the pressed crumb look and no hover look after",
    setup: App(BreadCrumbs),
    steps: [
        Wait(2),
        TouchTap(Role(role: Button, label: "Go to Panel B")),
        Wait(2),
        TouchDown(at: Within(Name("BreadCrumbs"), Role(role: Button, label: "Home")), finger: 0),
        Check(Component(
            target: Within(Name("BreadCrumbs"), Text("Home")),
            path: "TextColor.0",
            is: Eq(Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0))),
        )),
        TouchMove(to: Screen((900.0, 500.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(Component(
            target: Within(Name("BreadCrumbs"), Role(role: Button, label: "Home")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(Component(
            target: Within(Name("BreadCrumbs"), Text("Home")),
            path: "TextColor.0",
            is: Eq(Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0))),
        )),
    ],
    expect: [],
)
