// A click outside an open combo closes it and leaves the selection as it is.
// `combo.rs` reads ButtonInput<MouseButton> for this, not a pointer event on
// the list. A click on the combo's own button closes it as well.
(
    format_version: 3,
    name: "a click outside an open combo closes it without changing the selection",
    setup: App(Combos),
    steps: [
        Wait(2),
        // Nothing selected: an outside click closes and selects nothing.
        MoveTo(Within(Name("first combo"), Component("ComboButton"))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        Check(Visible(Within(Name("first combo"), Component("ComboList")))),
        MoveTo(Screen((900.0, 500.0))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
        Check(App(Selected(of: Name("first combo"), items: []))),
        Check(TextOf(Within(Name("first combo"), Component("ComboButton")), StartsWith("Select.."))),
        // With "Canada" selected.
        MoveTo(Within(Name("first combo"), Component("ComboButton"))),
        Click(Left),
        MoveTo(Within(Name("first combo"), Role(role: Button, label: "Canada"))),
        Click(Left),
        Check(App(Selected(of: Name("first combo"), items: ["Canada"]))),
        MoveTo(Within(Name("first combo"), Component("ComboButton"))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        Check(Visible(Nth(2, Within(Name("first combo"), Component("ItemView"))))),
        MoveTo(Screen((900.0, 500.0))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
        Check(App(Selected(of: Name("first combo"), items: ["Canada"]))),
        Check(App(Selected(of: Name("country list"), items: ["Canada"]))),
        Check(TextOf(Within(Name("first combo"), Component("ComboButton")), StartsWith("Canada"))),
        // The button toggles: open, then closed again.
        MoveTo(Within(Name("first combo"), Component("ComboButton"))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        Click(Left),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
        Check(App(Selected(of: Name("first combo"), items: ["Canada"]))),
    ],
    expect: [App(Selected(of: Name("first combo"), items: ["Canada"]))],
)
