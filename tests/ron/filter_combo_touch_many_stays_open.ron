// A tap on an option of a filter combo over many items picks it and leaves the popup open; a
// tap outside closes it and the picks stay.
(
    format_version: 3,
    name: "taps on a filter combo's options over many items keep the popup open",
    setup: App(FilterCombos),
    steps: [
        Wait(2),
        TouchTap(Within(Name("multi filter combo"), Component("ComboButton"))),
        Wait(3),
        TouchTap(Nth(0, Within(Name("multi filter combo"), Component("ItemView")))),
        Wait(2),
        Check(Component(target: Name("multi filter combo"), path: "ComboState", is: Eq(Open))),
        TouchTap(Nth(1, Within(Name("multi filter combo"), Component("ItemView")))),
        Wait(2),
        Check(Component(target: Name("multi filter combo"), path: "ComboState", is: Eq(Open))),
        Check(App(Selected(of: Name("multi filter combo"), items: ["Amsterdam", "Delft"]))),
        TouchTap(Screen((900.0, 500.0))),
        Wait(2),
        Check(Component(target: Name("multi filter combo"), path: "ComboState", is: Eq(Closed))),
        Check(App(Selected(of: Name("multi filter combo"), items: ["Amsterdam", "Delft"]))),
    ],
    expect: [],
)
