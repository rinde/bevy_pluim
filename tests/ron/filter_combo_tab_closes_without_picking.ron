// Tab and Shift+Tab leave the popup: it closes without picking the active option and the focus
// goes where the key sent it, not back into the hidden search box.
(
    format_version: 3,
    name: "Tab and Shift+Tab close a filter combo without picking",
    setup: App(FilterCombos),
    steps: [
        Wait(2),
        Tap(key: Tab),
        Check(App(Focused(of: Within(Name("filter combo"), Component("ComboButton"))))),
        Tap(key: Enter),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Open))),
        Check(App(Focused(of: Within(Name("filter combo"), Component("TextInput"))))),
        Type(text: "del"),
        Wait(2),
        Check(App(Active(of: Within(Name("filter combo"), Component("TextInput")), is: Nth(1, Within(Name("filter combo"), Component("ItemView")))))),
        Tap(key: Tab),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Closed))),
        Check(App(Selected(of: Name("filter combo"), items: []))),
        Check(Not(App(Focused(of: Within(Name("filter combo"), Component("TextInput")))))),
        Key(key: ShiftLeft),
        Tap(key: Tab),
        KeyUp(key: ShiftLeft),
        Wait(1),
        Check(App(Focused(of: Within(Name("filter combo"), Component("ComboButton"))))),
        Tap(key: Enter),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Open))),
        Check(App(Focused(of: Within(Name("filter combo"), Component("TextInput"))))),
        Type(text: "ut"),
        Wait(2),
        Key(key: ShiftLeft),
        Tap(key: Tab),
        KeyUp(key: ShiftLeft),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Closed))),
        Check(App(Selected(of: Name("filter combo"), items: []))),
        Check(App(Focused(of: Within(Name("filter combo"), Component("ComboButton"))))),
    ],
    expect: [],
)
