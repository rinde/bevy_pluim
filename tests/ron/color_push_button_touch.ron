(
    format_version: 3,
    name: "a touch tap activates a color button and a slide-off does not",
    setup: App(ButtonNames),
    steps: [
        Wait(2),
        TouchDown(at: Name("color button"), finger: 0),
        TouchMove(to: Name("plain button"), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(Resource(path: "TouchTaps.color", is: Eq(0))),
        TouchTap(Name("color button")),
        Check(Resource(path: "TouchTaps.color", is: Eq(1))),
    ],
    expect: [Resource(path: "TouchTaps.color", is: Eq(1))],
)
