// A combo opened from the keyboard closes on a click on empty space, as any outside click does,
// and the focus, which the click took off the list, goes back to the button.
(
    format_version: 3,
    name: "a click elsewhere closes a combo opened from the keyboard and returns the focus",
    setup: App(Combos),
    steps: [
        Wait(2),
        Tap(key: Tab),
        Tap(key: Enter),
        Wait(1),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        MoveTo(Screen((900.0, 500.0))),
        Click(Left),
        Wait(2),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(App(Focused(of: Within(Name("first combo"), Component("ComboButton"))))),
    ],
    expect: [],
)
