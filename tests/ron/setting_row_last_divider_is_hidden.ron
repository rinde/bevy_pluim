// A column of setting rows keeps the divider under every row but the last, and
// the control in a row's slot works: picking "Dark" in the first row's
// segmented control selects it.
(
    format_version: 3,
    name: "setting rows show a divider between rows and their controls work",
    setup: App(SettingRows),
    steps: [
        Wait(2),
        Check(Visible(Within(Name("appearance row"), Text("Appearance")))),
        Check(Visible(Within(Name("appearance row"), Text("Light or dark")))),
        Check(Component(target: Nth(0, Within(Name("setting rows"), Name("Divider"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(1, Within(Name("setting rows"), Name("Divider"))), path: "Node.display", is: Eq(Flex))),
        Check(Component(target: Nth(2, Within(Name("setting rows"), Name("Divider"))), path: "Node.display", is: Eq(None))),
        Check(App(Selected(of: Within(Name("appearance row"), Component("SegmentedControl")), items: ["Light"]))),
        MoveTo(Within(Name("appearance row"), Text("Dark"))),
        Click(Left),
        Check(App(Selected(of: Within(Name("appearance row"), Component("SegmentedControl")), items: ["Dark"]))),
        Check(TextOf(Within(Name("text size row"), Component("NumericStepper")), Exact("12"))),
    ],
    expect: [],
)
