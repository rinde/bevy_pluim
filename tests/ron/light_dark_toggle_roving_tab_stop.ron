// The light dark toggle is one tab stop: Tab enters at the option of the current preference
// (System), the next Tab leaves for "Change theme" and Shift+Tab comes back to the preference's
// option. The arrows move the focus (with the ring) and set the preference, wrap round, and Home
// and End go to the ends.
(
    format_version: 3,
    name: "a light dark toggle is one tab stop with arrow keys between its options",
    setup: App(LightDarkToggle),
    steps: [
        Wait(2),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "Light")), path: "TabIndex.0", is: Eq(-1))),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "System")), path: "TabIndex.0", is: Eq(0))),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "Dark")), path: "TabIndex.0", is: Eq(-1))),
        Tap(key: Tab),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "System"))))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: Tab),
        Check(App(Focused(of: Role(role: Button, label: "Change theme")))),
        Key(key: ShiftLeft),
        Tap(key: Tab),
        KeyUp(key: ShiftLeft),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "System"))))),
        Tap(key: ArrowRight),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: ArrowRight),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Light"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Light))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: ArrowLeft),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: ArrowUp),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "System"))))),
        Check(Resource(path: "ThemePreference", is: Eq(System))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: ArrowDown),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: Home),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Light"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Light))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Tap(key: End),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
        Check(Count(with: ["Outline"], is: Eq(1))),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "Dark")), path: "TabIndex.0", is: Eq(0))),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "Light")), path: "TabIndex.0", is: Eq(-1))),
        Check(Component(target: Within(Name("light dark toggle"), Role(role: Button, label: "System")), path: "TabIndex.0", is: Eq(-1))),
        Tap(key: End),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
        Check(Resource(path: "ThemePreference", is: Eq(Dark))),
        Tap(key: Tab),
        Check(App(Focused(of: Role(role: Button, label: "Change theme")))),
        Key(key: ShiftLeft),
        Tap(key: Tab),
        KeyUp(key: ShiftLeft),
        Check(App(Focused(of: Within(Name("light dark toggle"), Role(role: Button, label: "Dark"))))),
    ],
    expect: [],
)
