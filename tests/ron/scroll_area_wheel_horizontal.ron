// The wheel over the horizontal scroll area scrolls its contents sideways
// and back, and not down: the area only scrolls horizontally. A positive
// wheel x is "left", so the scroll position moves by the opposite amount.
// The scroll position read is the one the layout settles on
// (ComputedNode.scroll_position), clamped to what overflows (the ScrollPosition component is kept in that range
// too, but the layout shows it a pass later).
(
    format_version: 3,
    name: "the wheel scrolls a horizontal scroll area",
    setup: App(ScrollAreas),
    steps: [
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.x",
            is: Eq(0.0),
        )),
        MoveTo(Name("horizontal scroll area")),
        Wheel(x: -100.0, y: 0.0),
        Wait(2),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.x",
            is: Eq(100.0),
        )),
        Wheel(x: 40.0, y: 0.0),
        Wait(2),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.x",
            is: Eq(60.0),
        )),
        Wheel(x: 0.0, y: -100.0),
        Wait(2),
        Check(Component(
            target: Within(Name("horizontal scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
