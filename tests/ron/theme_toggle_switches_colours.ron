// "Change theme" calls Theme::light_dark_toggle: the Theme resource's colours
// are DEFAULT_LIGHT_THEME_COLORS at the start, DEFAULT_DARK_THEME_COLORS after
// one click and the light ones again after a second. Every slot is compared,
// so a toggle that swaps only some of them fails. The button lives in the
// test setup (the library has no toggle widget).
(
    format_version: 3,
    name: "the theme toggle switches the colours between the light and the dark theme",
    setup: App(Themed),
    steps: [
        Wait(2),
        Check(Resource(
            path: "Theme.colors",
