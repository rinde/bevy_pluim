// "Change theme" calls Theme::light_dark_toggle: the Theme resource's colours
// are DEFAULT_LIGHT_THEME_COLORS at the start, DEFAULT_DARK_THEME_COLORS after
// one click and the light ones again after a second. Every slot is compared,
// so a toggle that swaps only some of them fails. The button lives in the
// test setup (the library has no toggle widget).
(
    format_version: 3,
    name: "the theme toggle switches the colours between the light and the dark theme",
    setup: App(Themed),
    steps: [
        Wait(2),
        Check(Resource(
            path: "Theme.colors",
            is: Eq((background_primary:Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0)),background_secondary:Srgba((red:0.8980392,green:0.90588236,blue:0.92156863,alpha:1.0)),background_blocker:Srgba((red:0.41960785,green:0.44705883,blue:0.5019608,alpha:0.75)),selected_item:Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0)),hovered_item:Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0)),selected_hovered_item:Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0)),border:Srgba((red:0.8980392,green:0.90588236,blue:0.92156863,alpha:1.0)),border_highlight:Srgba((red:0.3764706,green:0.64705884,blue:0.98039216,alpha:1.0)),text_primary:Srgba((red:0.06666667,green:0.09411765,blue:0.15294118,alpha:1.0)),text_disabled:Srgba((red:0.6117647,green:0.6392157,blue:0.6862745,alpha:1.0)),link:Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0)),link_selected:Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0)),large_shadow:Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.15)),small_shadow:Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.05)),scroll_thumb_background:Srgba((red:0.6117647,green:0.6392157,blue:0.6862745,alpha:1.0)))),
        )),
        MoveTo(Role(role: Button, label: "Change theme")),
        Click(Left),
        Wait(2),
        Check(Resource(
            path: "Theme.colors",
            is: Eq((background_primary:Srgba((red:0.011764706,green:0.02745098,blue:0.07058824,alpha:1.0)),background_secondary:Srgba((red:0.12156863,green:0.16078432,blue:0.21568628,alpha:1.0)),background_blocker:Srgba((red:0.011764706,green:0.02745098,blue:0.07058824,alpha:0.75)),selected_item:Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0)),hovered_item:Srgba((red:0.11764706,green:0.22745098,blue:0.5411765,alpha:1.0)),selected_hovered_item:Srgba((red:0.11372549,green:0.30588236,blue:0.84705883,alpha:1.0)),border:Srgba((red:0.21568628,green:0.25490198,blue:0.31764707,alpha:1.0)),border_highlight:Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0)),text_primary:Srgba((red:0.9529412,green:0.95686275,blue:0.9647059,alpha:1.0)),text_disabled:Srgba((red:0.29411766,green:0.33333334,blue:0.3882353,alpha:1.0)),link:Srgba((red:0.3764706,green:0.64705884,blue:0.98039216,alpha:1.0)),link_selected:Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0)),large_shadow:Srgba((red:1.0,green:1.0,blue:1.0,alpha:0.05)),small_shadow:Srgba((red:1.0,green:1.0,blue:1.0,alpha:0.03)),scroll_thumb_background:Srgba((red:0.29411766,green:0.33333334,blue:0.3882353,alpha:1.0)))),
        )),
        // The second toggle restores the light colours.
        Click(Left),
        Wait(2),
        Check(Resource(
            path: "Theme.colors",
            is: Eq((background_primary:Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0)),background_secondary:Srgba((red:0.8980392,green:0.90588236,blue:0.92156863,alpha:1.0)),background_blocker:Srgba((red:0.41960785,green:0.44705883,blue:0.5019608,alpha:0.75)),selected_item:Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0)),hovered_item:Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0)),selected_hovered_item:Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0)),border:Srgba((red:0.8980392,green:0.90588236,blue:0.92156863,alpha:1.0)),border_highlight:Srgba((red:0.3764706,green:0.64705884,blue:0.98039216,alpha:1.0)),text_primary:Srgba((red:0.06666667,green:0.09411765,blue:0.15294118,alpha:1.0)),text_disabled:Srgba((red:0.6117647,green:0.6392157,blue:0.6862745,alpha:1.0)),link:Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0)),link_selected:Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0)),large_shadow:Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.15)),small_shadow:Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.05)),scroll_thumb_background:Srgba((red:0.6117647,green:0.6392157,blue:0.6862745,alpha:1.0)))),
        )),
    ],
    expect: [],
)
