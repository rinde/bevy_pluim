(
    format_version: 3,
    name: "a finger dragging the thumb scrolls the contents",
    setup: App(ScrollAreas),
    steps: [
        Wait(2),
        TouchDrag(from: Within(Name("vertical scroll area"), Name("ScrollThumb")), to: Screen((436.0, 140.0)), frames: 5),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Between(100.0, 200.0),
        )),
        TouchDrag(from: Within(Name("vertical scroll area"), Name("ScrollThumb")), to: Screen((436.0, 400.0)), frames: 5),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(220.0),
        )),
        TouchDrag(from: Within(Name("vertical scroll area"), Name("ScrollThumb")), to: Screen((436.0, 0.0)), frames: 5),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
