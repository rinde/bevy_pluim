// A combo is usable from the keyboard: Tab focuses its button, Enter opens the popup and puts
// the focus on its list, the arrow keys move through the entries and Enter picks one, which
// closes the popup again.
(
    format_version: 3,
    name: "Tab, Enter and the arrow keys open a combo, move in its list and pick",
    setup: App(Combos),
    steps: [
        Wait(2),
        Tap(key: Tab),
        Check(App(Focused(of: Within(Name("first combo"), Component("ComboButton"))))),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Tap(key: Enter),
        Wait(1),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Open))),
        Check(Visible(Within(Name("first combo"), Component("ComboList")))),
        Check(App(Focused(of: Within(Name("first combo"), Component("ComboList"))))),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: Enter),
        Wait(1),
        Check(Component(target: Name("first combo"), path: "ComboState", is: Eq(Closed))),
        Check(Not(Visible(Within(Name("first combo"), Component("ComboList"))))),
        Check(Not(App(Selected(of: Name("first combo"), items: [])))),
        // The focus is not left on the hidden list.
        Check(Not(App(Focused(of: Within(Name("first combo"), Component("ComboList")))))),
    ],
    expect: [],
)
