(
    format_version: 3,
    name: "a setting row is a group labeled with its title",
    setup: App(SettingRows),
    steps: [
        Wait(2),
        Check(App(Accessible(
            of: Name("appearance row"),
            role: Some("Group"),
            label: Some("Appearance"),
            value: None,
            states: [Shown],
        ))),
        Check(App(Accessible(
            of: Name("last row"),
            role: Some("Group"),
            label: Some("Reset"),
            value: None,
            states: [],
        ))),
    ],
    expect: [],
)
