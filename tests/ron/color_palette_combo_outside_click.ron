// A click outside an open palette combo closes its popup and leaves the
// selection (and the colour on the button) as it is. `color_palette_combo.rs`
// reads ButtonInput<MouseButton> for this. A click on a swatch of another
// palette is outside as well, although the popup floats over it.
(
    format_version: 3,
    name: "a click outside an open palette combo closes it without changing the selection",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        // Nothing selected: an outside click closes and selects nothing.
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(Visible(Name("first palette combo popup"))),
        MoveTo(Screen((1100.0, 600.0))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(App(Selected(of: Name("first palette combo"), items: []))),
        Check(Component(
            target: Within(Name("first palette combo"), Component("ColorSquare")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.0,green:0.0,blue:0.0,alpha:0.0))),
        )),
        // With red-500 selected.
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        MoveTo(Nth(60, Within(Name("first palette combo popup"), Component("ItemView")))),
        Click(Left),
        Check(App(Selected(of: Name("first palette combo"), items: ["red-500"]))),
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        MoveTo(Screen((1100.0, 600.0))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(App(Selected(of: Name("first palette combo"), items: ["red-500"]))),
        Check(Component(
            target: Within(Name("first palette combo"), Component("ColorSquare")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9372549,green:0.26666668,blue:0.26666668,alpha:1.0))),
        )),
        // A click on a swatch of the palette (the last one, which the popup
        // does not cover) is outside the combo as well: it selects the colour
        // in the palette, closes the popup and leaves the combo's selection.
        MoveTo(Within(Name("first palette combo"), Component("ColorPushButton"))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        MoveTo(Nth(241, Within(Name("palette"), Component("ItemView")))),
        Click(Left),
        Check(Component(target: Name("first palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(Not(Visible(Name("first palette combo popup")))),
        Check(App(Selected(of: Name("palette"), items: ["rose-950"]))),
        Check(App(Selected(of: Name("first palette combo"), items: ["red-500"]))),
    ],
    expect: [App(Selected(of: Name("first palette combo"), items: ["red-500"]))],
)
