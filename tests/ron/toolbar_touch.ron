(
    format_version: 3,
    name: "a touch tap on a tool picks it and leaves no hover look",
    setup: App(Toolbar),
    steps: [
        Wait(2),
        Capture(name: "resting background", value: Component(target: Within(Name("filled toolbar"), Role(role: Button, label: "Build")), path: "BackgroundColor.0")),
        Capture(name: "resting ink", value: Component(target: Within(Name("filled toolbar"), Text("Build")), path: "TextColor.0")),
        TouchDown(at: Within(Name("filled toolbar"), Role(role: Button, label: "Build")), finger: 0),
        TouchMove(to: Screen((900.0, 500.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(App(Selected(of: Name("filled toolbar"), items: ["Select"]))),
        Check(Component(target: Within(Name("filled toolbar"), Role(role: Button, label: "Build")), path: "BackgroundColor.0", is: Eq(Captured("resting background")))),
        Check(Component(target: Within(Name("filled toolbar"), Text("Build")), path: "TextColor.0", is: Eq(Captured("resting ink")))),
        TouchTap(Within(Name("filled toolbar"), Role(role: Button, label: "Build"))),
        Wait(2),
        Check(App(Selected(of: Name("filled toolbar"), items: ["Build"]))),
        Check(App(Focused(of: Within(Name("filled toolbar"), Role(role: Button, label: "Build"))))),
        Check(Component(target: Within(Name("filled toolbar"), Role(role: Button, label: "Select")), path: "BackgroundColor.0", is: Eq(Captured("resting background")))),
        TouchTap(Within(Name("filled toolbar"), Role(role: Button, label: "Select"))),
        Wait(2),
        Check(App(Selected(of: Name("filled toolbar"), items: ["Select"]))),
        Check(Component(target: Within(Name("filled toolbar"), Text("Build")), path: "TextColor.0", is: Eq(Captured("resting ink")))),
        TouchTap(Nth(1, Within(Name("icon only toolbar"), Name("ToolbarButton")))),
        Wait(2),
        Check(App(Selected(of: Name("icon only toolbar"), items: ["Signal"]))),
        TouchTap(Nth(1, Within(Name("underlined toolbar"), Name("ToolbarButton")))),
        Wait(2),
        Check(App(Selected(of: Name("underlined toolbar"), items: ["Stops"]))),
        TouchTap(Within(Name("optional toolbar"), Role(role: Button, label: "Pan"))),
        Wait(2),
        Check(App(Selected(of: Name("optional toolbar"), items: ["Pan"]))),
        TouchTap(Within(Name("optional toolbar"), Role(role: Button, label: "Pan"))),
        Wait(2),
        Check(App(Selected(of: Name("optional toolbar"), items: []))),
        Capture(name: "resting tone background", value: Component(target: Within(Name("optional toolbar"), Role(role: Button, label: "Zoom")), path: "BackgroundColor.0")),
        TouchDown(at: Within(Name("optional toolbar"), Role(role: Button, label: "Zoom")), finger: 0),
        TouchMove(to: Screen((900.0, 500.0)), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(App(Selected(of: Name("optional toolbar"), items: []))),
        Check(Component(target: Within(Name("optional toolbar"), Role(role: Button, label: "Zoom")), path: "BackgroundColor.0", is: Eq(Captured("resting tone background")))),
        TouchTap(Within(Name("optional toolbar"), Role(role: Button, label: "Zoom"))),
        Wait(2),
        Check(App(Selected(of: Name("optional toolbar"), items: ["Zoom"]))),
        TouchTap(Within(Name("optional toolbar"), Role(role: Button, label: "Zoom"))),
        Wait(2),
        Check(App(Selected(of: Name("optional toolbar"), items: []))),
        Check(Component(target: Within(Name("optional toolbar"), Role(role: Button, label: "Zoom")), path: "BackgroundColor.0", is: Eq(Captured("resting tone background")))),
        Wait(40),
        Check(Not(Exists(Text("Trains")))),
        Check(Not(Exists(Text("Stops")))),
    ],
    expect: [],
)
