// The `long filter combo` is low in the window, so its popup opens upward, capped to the room
// above and scrolling. Arrowing down past the visible rows scrolls the list (not a scroll area
// around it) to keep the active option in view, and back up to the first returns to the top; a
// held arrow key does not reach an application's directional navigation.
(
    format_version: 3,
    name: "arrow keys scroll a capped filter combo popup to the active result",
    setup: App(FilterCombos),
    steps: [
        Wait(2),
        MoveTo(Within(Name("long filter combo"), Component("ComboButton"))),
        Click(Left),
        Wait(3),
        Type(text: "option"),
        Wait(2),
        Check(Component(target: Within(Name("long filter combo"), Component("ComboList")), path: "ScrollPosition.0.y", is: Eq(0.0))),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Tap(key: ArrowDown),
        Wait(3),
        Check(App(Active(of: Within(Name("long filter combo"), Component("TextInput")), is: Nth(30, Within(Name("long filter combo"), Component("ItemView")))))),
        Check(Component(target: Within(Name("long filter combo"), Component("ComboList")), path: "ScrollPosition.0.y", is: Gt(0.0))),
        Key(key: ArrowUp),
        Wait(40),
        KeyUp(key: ArrowUp),
        Wait(3),
        Check(App(Active(of: Within(Name("long filter combo"), Component("TextInput")), is: Nth(29, Within(Name("long filter combo"), Component("ItemView")))))),
        Check(Component(target: Name("long filter combo"), path: "ComboState", is: Eq(Open))),
    ],
    expect: [],
)
