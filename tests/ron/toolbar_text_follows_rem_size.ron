(
    format_version: 3,
    name: "a toolbar label is sized in rem and fits its box at any text size",
    setup: App(Toolbar),
    steps: [
        Wait(2),
        Check(Component(target: Within(Name("filled toolbar"), Text("Select")), path: "TextFont.font_size", is: Eq(Rem(0.6)))),
        Capture(name: "box", value: Component(target: Nth(0, Within(Name("filled toolbar"), Name("ToolbarButton"))), path: "ComputedNode.size.x", unit: Logical)),
        Check(Component(target: Within(Name("filled toolbar"), Text("Select")), path: "TextLayoutInfo.size.x", unit: Logical, is: Le(Captured("box")))),
        Capture(name: "box height", value: Component(target: Nth(0, Within(Name("filled toolbar"), Name("ToolbarButton"))), path: "ComputedNode.size.y", unit: Logical)),
        Check(Component(target: Nth(0, Within(Name("filled toolbar"), Name("ToolbarButton"))), path: "ComputedNode.content_size.y", unit: Logical, is: Le(Captured("box height")))),
        MoveTo(Role(role: Button, label: "Change theme")),
    ],
    expect: [],
)
