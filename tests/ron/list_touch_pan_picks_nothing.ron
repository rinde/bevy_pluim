(
    format_version: 3,
    name: "a touch pan over a list scrolls its area and picks nothing",
    setup: App(Lists),
    steps: [
        Wait(2),
        TouchDown(at: Within(Name("list scroll area"), Role(role: ListItem, label: "Row 2")), finger: 0),
        TouchMove(to: Within(Name("list scroll area"), Role(role: ListItem, label: "Row 1")), finger: 0),
        TouchUp(finger: 0),
        Wait(2),
        Check(Component(target: Within(Name("list scroll area"), Component("ScrollContents")), path: "ScrollPosition.0.y", is: Gt(0.0))),
        Check(App(Selected(of: Name("scrolling list"), items: ["Row 1"]))),
        // A fling outlives the lift; the wheel stops it.
        MoveTo(Name("list scroll area")),
        Wheel(x: 0.0, y: 100000.0),
        Wheel(x: 0.0, y: -60.0),
        Wait(1),
        TouchTap(Within(Name("list scroll area"), Role(role: ListItem, label: "Row 3"))),
        Wait(1),
        Check(App(Selected(of: Name("scrolling list"), items: ["Row 3"]))),
    ],
    expect: [],
)
