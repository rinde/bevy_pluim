// The wheel keeps the vertical scroll area's ScrollPosition inside what
// overflows: turned far past the end, the component stops at the end (214, not
// 1000), so one step back already moves the contents, and past the top it
// stops at 0. A positive wheel y is "up".
(
    format_version: 3,
    name: "the wheel keeps a scroll position within the overflow",
    setup: App(ScrollAreas),
    steps: [
        MoveTo(Name("vertical scroll area")),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(214.0),
        )),
        // One step back moves what is shown at once.
        Wheel(x: 0.0, y: 100.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ComputedNode.scroll_position.y",
            is: Lt(214.0),
        )),
        // Far past the top stops at the top.
        Wheel(x: 0.0, y: 5000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
