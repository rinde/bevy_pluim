(
    format_version: 3,
    name: "the wheel keeps a scroll position within the overflow",
    setup: App(ScrollAreas),
    steps: [
        MoveTo(Name("vertical scroll area")),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wheel(x: 0.0, y: -100.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(220.0),
        )),
        Wheel(x: 0.0, y: 100.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Lt(220.0),
        )),
        Wheel(x: 0.0, y: 5000.0),
        Wait(2),
        Check(Component(
            target: Within(Name("vertical scroll area"), Component("ScrollContents")),
            path: "ScrollPosition.0.y",
            is: Eq(0.0),
        )),
    ],
    expect: [],
)
