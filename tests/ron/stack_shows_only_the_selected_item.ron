// A `Stack` sharing the trail's selection shows only the `StackItem` of the
// last selected item, creates a child the first time its item is selected and
// then keeps it, hidden (`Display::None`) rather than despawned, when it is
// deselected. A hidden panel still exists but takes up no room, so
// `Not(Visible(..))`; one never selected does not exist at all.
//
// The number of `PushButton`s counts the panels that were created: "Change
// theme" and the three buttons of Home are 4, "Go back to home" and "Go to
// panel A variant" of Panel A make 6, "Go back to home" and "Go to panel B
// sub" of Panel B 8 and "Go back to panel B" of Panel B sub 9. A panel made
// twice, or not kept, would show in that count.
(
    format_version: 3,
    name: "a stack shows only the selected item and creates each one once",
    setup: App(BreadCrumbs),
    steps: [
        Wait(2),
        // Only Home was selected, so only Home was created.
        Check(Visible(Within(Name("Stack"), Text("Home")))),
        Check(Not(Exists(Within(Name("Stack"), Text("Panel A"))))),
        Check(Not(Exists(Within(Name("Stack"), Text("Panel B"))))),
        Check(Not(Exists(Within(Name("Stack"), Text("Panel B sub"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(4))),

        // Panel A is created when it is selected, and Home is hidden, kept.
        MoveTo(Role(role: Button, label: "Go to Panel A")), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Panel A")))),
        Check(Exists(Within(Name("Stack"), Text("Home")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Home"))))),
        Check(Not(Exists(Within(Name("Stack"), Text("Panel B"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(6))),
        Check(Tree(of: Name("Stack"), matches: r#"
            - panel "Stack":
              - panel "StackItem":
                - text "Panel A"
                - button "Go back to home"
                - button "Go to panel A variant"
        "#)),

        // Back to Home: Panel A is hidden and kept, nothing is created.
        MoveTo(Within(Name("Stack"), Role(role: Button, label: "Go back to home"))), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Home")))),
        Check(Exists(Within(Name("Stack"), Text("Panel A")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel A"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(6))),

        // And to Panel A once more: the same panel shows, still 6 buttons.
        MoveTo(Role(role: Button, label: "Go to Panel A")), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Panel A")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Home"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(6))),

        // "Panel A variant" is another item that reuses the creator of
        // "Panel A": it shows the panel that exists instead of making a second.
        MoveTo(Role(role: Button, label: "Go to panel A variant")), Click(Left),
        Wait(2),
        Check(App(Selected(of: Name("BreadCrumbs"), items: ["Home", "Panel A variant"]))),
        Check(Visible(Within(Name("Stack"), Text("Panel A")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Home"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(6))),
        MoveTo(Within(Name("Stack"), Role(role: Button, label: "Go back to home"))), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Home")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel A"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(6))),

        // Panel B and, below it, Panel B sub are created in turn. Each shows
        // alone and the ones before it are hidden.
        MoveTo(Role(role: Button, label: "Go to Panel B")), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Panel B")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Home"))))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel A"))))),
        Check(Not(Exists(Within(Name("Stack"), Text("Panel B sub"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(8))),
        MoveTo(Role(role: Button, label: "Go to panel B sub")), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Panel B sub")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel B"))))),
        Check(Not(Visible(Within(Name("Stack"), Text("Home"))))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel A"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(9))),

        // Back up to Panel B, hidden Panel B sub kept.
        MoveTo(Role(role: Button, label: "Go back to panel B")), Click(Left),
        Wait(2),
        Check(Visible(Within(Name("Stack"), Text("Panel B")))),
        Check(Exists(Within(Name("Stack"), Text("Panel B sub")))),
        Check(Not(Visible(Within(Name("Stack"), Text("Panel B sub"))))),
        Check(Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(9))),
    ],
    expect: [
        Visible(Within(Name("Stack"), Text("Panel B"))),
        Not(Visible(Within(Name("Stack"), Text("Panel B sub")))),
        Count(with: ["rin_bevy_ui::push_button::PushButton"], is: Eq(9)),
    ],
)
