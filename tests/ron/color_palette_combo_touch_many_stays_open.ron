// Taps on the swatches of a palette combo over many colours pick them and keep the popup open;
// a tap outside closes it and the picks stay.
(
    format_version: 3,
    name: "taps on a palette combo's swatches over many keep the popup open",
    setup: App(ColorPalette),
    steps: [
        Wait(2),
        TouchTap(Within(Name("zero or more palette combo"), Component("ColorPushButton"))),
        Wait(1),
        TouchTap(Nth(60, Within(Name("zero or more palette combo popup"), Component("ItemView")))),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        TouchTap(Nth(5, Within(Name("zero or more palette combo popup"), Component("ItemView")))),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Open))),
        Check(App(Selected(of: Name("zero or more palette combo"), items: ["red-500", "slate-500"]))),
        TouchTap(Screen((1100.0, 600.0))),
        Check(Component(target: Name("zero or more palette combo"), path: "ColorPaletteComboState", is: Eq(Closed))),
        Check(App(Selected(of: Name("zero or more palette combo"), items: ["red-500", "slate-500"]))),
    ],
    expect: [],
)
