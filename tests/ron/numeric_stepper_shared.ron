// "shared stepper" holds a u32 Value (3, from 0 to 6); the two mirror steppers
// carry a ValueRef to it and hold none. A press on any of them changes the one
// value, and all three show it, whichever was pressed. The bounds of the shared
// value hold for the mirrors too.
(
    format_version: 3,
    name: "steppers sharing a value through ValueRef update it together",
    setup: App(NumericStepper),
    steps: [
        Check(TextOf(Name("shared stepper"), Exact("- 3 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 3 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 3 +"))),
        Check(Component(target: Name("shared stepper"), path: "Value.0.value", is: Eq(3))),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 4 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 4 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 4 +"))),
        Check(Component(target: Name("shared stepper"), path: "Value.0.value", is: Eq(4))),
        MoveTo(Within(Name("second mirror stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 5 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 5 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 5 +"))),
        MoveTo(Within(Name("shared stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 4 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 4 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 4 +"))),
        Check(Component(target: Name("shared stepper"), path: "Value.0.value", is: Eq(4))),
        MoveTo(Within(Name("second mirror stepper"), Role(role: Button, label: "+"))), Click(Left),
        MoveTo(Within(Name("second mirror stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 6 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 6 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 6 +"))),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "+"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 6 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 6 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 6 +"))),
        Check(Component(target: Name("shared stepper"), path: "Value.0.value", is: Eq(6))),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        MoveTo(Within(Name("first mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 0 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 0 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 0 +"))),
        MoveTo(Within(Name("second mirror stepper"), Role(role: Button, label: "-"))), Click(Left),
        Check(TextOf(Name("shared stepper"), Exact("- 0 +"))),
        Check(TextOf(Name("first mirror stepper"), Exact("- 0 +"))),
        Check(TextOf(Name("second mirror stepper"), Exact("- 0 +"))),
    ],
    expect: [Component(target: Name("shared stepper"), path: "Value.0.value", is: Eq(0))],
)
