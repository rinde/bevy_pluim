// With nothing matching, the popup says "No matching items" (a polite status for a screen
// reader), no option is active and Enter changes nothing and keeps the popup open.
(
    format_version: 3,
    name: "a filter combo with no match shows a status line and Enter does nothing",
    setup: App(FilterCombos),
    steps: [
        MoveTo(Within(Name("filter combo"), Component("ComboButton"))),
        Click(Left),
        Wait(3),
        Check(Component(target: Within(Name("filter combo"), Name("FilterComboEmpty")), path: "Node.display", is: Eq(None))),
        Type(text: "zzz"),
        Wait(2),
        Check(Component(target: Nth(0, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(1, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(2, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(3, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Nth(4, Within(Name("filter combo"), Component("ItemView"))), path: "Node.display", is: Eq(None))),
        Check(Component(target: Within(Name("filter combo"), Name("FilterComboEmpty")), path: "Node.display", is: Eq(Flex))),
        Check(App(Accessible(of: Within(Name("filter combo"), Name("FilterComboEmpty")), role: Some("Status"), label: Some("No matching items"), value: None, states: [Shown]))),
        Check(Not(App(Active(of: Within(Name("filter combo"), Component("TextInput")), is: Nth(0, Within(Name("filter combo"), Component("ItemView"))))))),
        Tap(key: Enter),
        Wait(2),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Open))),
        Check(App(Selected(of: Name("filter combo"), items: []))),
        Check(App(Focused(of: Within(Name("filter combo"), Component("TextInput"))))),
        Tap(key: ArrowDown),
        Wait(1),
        Check(Component(target: Name("filter combo"), path: "ComboState", is: Eq(Open))),
        Tap(key: Escape),
        Wait(2),
        Check(App(Accessible(of: Within(Name("filter combo"), Name("FilterComboEmpty")), role: Some("Status"), label: None, value: None, states: [Hidden]))),
    ],
    expect: [],
)
