// A combo inside a custom-view row of a list is the row's content, not the row: picking
// an option in it neither selects the outer row nor writes the row's item into the
// combo's own selection, which keeps showing the pick. Two rows, so that a second pick
// is checked against a row that is already selected by nobody.
(
    format_version: 3,
    name: "picking in a combo inside a list row leaves the list unselected",
    setup: App(ComboRows),
    steps: [
        Wait(2),
        Check(App(Selected(of: Name("row list"), items: []))),
        MoveTo(Within(Name("combo in row a"), Component("ComboButton"))),
        Click(Left),
        Check(Visible(Within(Name("combo in row a"), Component("ComboList")))),
        Check(App(Selected(of: Name("row list"), items: []))),
        MoveTo(Within(Name("combo in row a"), Role(role: ListItem, label: "Beta"))),
        Click(Left),
        Check(App(Selected(of: Name("combo in row a"), items: ["Beta"]))),
        Check(TextOf(Within(Name("combo in row a"), Component("ComboButton")), StartsWith("Beta"))),
        // The closed state is read from `ComboState` and `InheritedVisibility` because
        // `Not(Visible(..))` wrongly passes or fails here: rinde/rin-bevy-ui-tester#156.
        // Switch back to `Not(Visible(..))` once the tester fix is in.
        Check(Component(target: Name("combo in row a"), path: "ComboState", is: Eq(Closed))),
        Check(Component(target: Within(Name("combo in row a"), Component("ComboList")), path: "InheritedVisibility.0", is: Eq(false))),
        Check(App(Selected(of: Name("row list"), items: []))),
        // Another row's combo, picked the same way.
        MoveTo(Within(Name("combo in row b"), Component("ComboButton"))),
        Click(Left),
        MoveTo(Within(Name("combo in row b"), Role(role: ListItem, label: "Gamma"))),
        Click(Left),
        Check(App(Selected(of: Name("combo in row b"), items: ["Gamma"]))),
        Check(TextOf(Within(Name("combo in row b"), Component("ComboButton")), StartsWith("Gamma"))),
        Check(App(Selected(of: Name("combo in row a"), items: ["Beta"]))),
        Check(App(Selected(of: Name("row list"), items: []))),
    ],
    expect: [App(Selected(of: Name("row list"), items: []))],
)
