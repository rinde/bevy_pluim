// The item views of a list take their colours from the theme: the background
// of an item is background_primary, hovered_item, selected_item or
// selected_hovered_item, and the border of a clicked item is border_highlight
// while the border of a deselected one is border. Light theme first, then
// "Change theme" switches to the dark one and the same items take its slots.
// The colours are the slots of DEFAULT_LIGHT_THEME_COLORS (gray-50, blue-200,
// blue-500, blue-600, gray-200, blue-400) and DEFAULT_DARK_THEME_COLORS
// (gray-950, blue-900, blue-800, blue-700, gray-700). The "one-or-more list"
// starts on Netherlands. The theme button sits on a row of its own, away from
// the list, so moving there leaves every item un-hovered.
(
    format_version: 3,
    name: "list item colours follow the theme",
    setup: App(Lists),
    steps: [
        Wait(2),
        // Unselected and not hovered: background_primary.
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        // Selected and not hovered: selected_item.
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0))),
        )),
        // Hovered, not selected: hovered_item.
        MoveTo(Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada"))),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.7490196,green:0.85882354,blue:0.99607843,alpha:1.0))),
        )),
        // Hovered and selected: selected_hovered_item, with a highlighted border.
        Click(Left),
        Wait(2),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.14509805,green:0.3882353,blue:0.92156863,alpha:1.0))),
        )),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BorderColor.top",
            is: Eq(Srgba((red:0.3764706,green:0.64705884,blue:0.98039216,alpha:1.0))),
        )),
        // Selected, the pointer gone: selected_item.
        MoveTo(Role(role: Button, label: "Change theme")),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.23137255,green:0.50980395,blue:0.9647059,alpha:1.0))),
        )),
        // Deselect Netherlands: back to background_primary, with the plain border.
        MoveTo(Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands"))), Click(Left),
        MoveTo(Role(role: Button, label: "Change theme")),
        Wait(2),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.9764706,green:0.98039216,blue:0.9843137,alpha:1.0))),
        )),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BorderColor.top",
            is: Eq(Srgba((red:0.8980392,green:0.90588236,blue:0.92156863,alpha:1.0))),
        )),
        // The dark theme: the same items take the slots of the dark theme.
        Click(Left),
        Wait(2),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.011764706,green:0.02745098,blue:0.07058824,alpha:1.0))),
        )),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BorderColor.top",
            is: Eq(Srgba((red:0.21568628,green:0.25490198,blue:0.31764707,alpha:1.0))),
        )),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.11764706,green:0.2509804,blue:0.6862745,alpha:1.0))),
        )),
        MoveTo(Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands"))),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Netherlands")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.11764706,green:0.22745098,blue:0.5411765,alpha:1.0))),
        )),
        MoveTo(Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada"))),
        Check(Component(
            target: Within(Name("one-or-more list"), Role(role: ListItem, label: "Canada")),
            path: "BackgroundColor.0",
            is: Eq(Srgba((red:0.11372549,green:0.30588236,blue:0.84705883,alpha:1.0))),
        )),
    ],
    expect: [App(Selected(of: Name("one-or-more list"), items: ["Canada"]))],
)
